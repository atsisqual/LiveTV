<!doctype html>
<html lang="pt-PT">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>LiveTV</title>
<style>
:root{color-scheme:dark;--bg:#050607;--panel:#181b20;--panel2:#21252b;--line:#2b3038;--muted:#90959d;--accent:#6cc7ff;--white:#f7f8fa;--danger:#ff5366}*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:#000;color:var(--white);font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}body{padding-bottom:78px}.shell{width:100%;max-width:900px;margin:0 auto;background:#000;min-height:100vh}.appHeader{height:66px;display:flex;align-items:center;justify-content:space-between;padding:max(10px,env(safe-area-inset-top)) 17px 8px;background:#000;position:sticky;top:0;z-index:40}.headerLeft,.headerActions{display:flex;align-items:center;gap:12px}.avatar{width:34px;height:34px;border:2px solid #fff;border-radius:50%;display:grid;place-items:center}.avatar svg{width:20px;height:20px}.pageTitle{font-size:29px;font-weight:760;letter-spacing:-.035em}.iconBtn{width:42px;height:42px;border:0;background:transparent;color:#fff;border-radius:50%;display:grid;place-items:center}.iconBtn svg{width:27px;height:27px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.iconBtn:active{background:#25282d}.iconBtn.active svg{fill:#fff}.hero{position:relative;background:#0a0b0d;overflow:hidden;min-height:220px}.hero live-video-player,.hero live-video-skin{display:block;width:100%}.hero live-video-skin{aspect-ratio:16/9;background:#000}.hero video{width:100%;height:100%;background:#000}.heroBackdrop{position:absolute;inset:-24px;z-index:1;background:center/cover no-repeat;filter:blur(28px) saturate(.8);opacity:.24;transform:scale(1.08);transition:opacity .25s}.hero.loading .heroBackdrop,.hero.failed .heroBackdrop{opacity:.42}.heroShade{position:absolute;inset:0;z-index:2;background:linear-gradient(180deg,rgba(0,0,0,.05) 25%,rgba(0,0,0,.18) 52%,rgba(0,0,0,.88) 100%);pointer-events:none}.heroInfo{position:absolute;left:20px;right:78px;bottom:20px;z-index:5;pointer-events:none}.livePill{display:inline-flex;align-items:center;gap:7px;font-size:11px;font-weight:820;letter-spacing:.14em;text-transform:uppercase;margin-bottom:7px}.liveDot{width:8px;height:8px;border-radius:50%;background:#ff3348;box-shadow:0 0 0 4px rgba(255,51,72,.13)}.heroName{font-size:29px;line-height:1.04;font-weight:790;letter-spacing:-.04em;text-shadow:0 2px 15px rgba(0,0,0,.8)}.heroMeta{font-size:14px;color:#d1d4d9;margin-top:7px}.heroLogo{position:absolute;right:18px;bottom:20px;z-index:5;width:52px;height:52px;object-fit:contain;border-radius:13px;background:rgba(255,255,255,.95);padding:6px;box-shadow:0 8px 26px rgba(0,0,0,.3)}.heroFallback{position:absolute;inset:0;z-index:4;display:grid;place-items:center;pointer-events:none;opacity:0;transition:opacity .2s}.hero.loading .heroFallback,.hero.failed .heroFallback{opacity:1}.fallbackCard{display:flex;flex-direction:column;align-items:center;gap:10px;transform:translateY(-10px)}.fallbackLogo{width:78px;height:78px;object-fit:contain;border-radius:18px;background:rgba(255,255,255,.94);padding:10px;box-shadow:0 12px 40px rgba(0,0,0,.35)}.fallbackText{font-size:12px;color:#d6d9dd;background:rgba(0,0,0,.45);padding:7px 10px;border-radius:999px;backdrop-filter:blur(10px)}.retryBtn{pointer-events:auto;border:1px solid rgba(255,255,255,.18);border-radius:999px;background:rgba(20,22,26,.82);color:#fff;padding:9px 15px;font-size:12px;font-weight:720;display:none}.hero.failed .retryBtn{display:block}.hero.loading live-video-player{opacity:.45}.hero.failed live-video-player{opacity:.18}.status{position:absolute;left:14px;right:14px;top:10px;z-index:8;padding:8px 11px;border-radius:11px;background:rgba(17,19,23,.76);backdrop-filter:blur(12px);font-size:11px;color:#d2d5da;opacity:0;transform:translateY(-4px);transition:.18s;pointer-events:none}.status.show{opacity:1;transform:none}.status.error{color:#ffd1d6}.homeView{background:#000}.favoritesPanel{background:#1a1d22;border-radius:0 0 22px 22px;padding:19px 0 20px;overflow:hidden}.sectionHead{display:flex;align-items:center;justify-content:space-between;padding:0 18px;margin-bottom:13px}.sectionTitle{font-size:23px;font-weight:740;letter-spacing:-.03em}.sectionMeta{font-size:12px;color:#8f949c}.favoriteRail{display:flex;gap:10px;overflow-x:auto;padding:0 18px 10px;scrollbar-width:none;scroll-snap-type:x proximity}.favoriteRail::-webkit-scrollbar{display:none}.favCard{position:relative;flex:0 0 86px;height:86px;border-radius:20px;border:1px solid #343942;background:#1d2025;display:grid;place-items:center;padding:11px;scroll-snap-align:start;color:#fff}.favCard.active{background:#3a3e45;border-color:#4b515a;box-shadow:0 8px 20px rgba(0,0,0,.24)}.favCard.active:after{content:"";position:absolute;right:9px;top:8px;width:7px;height:7px;border-radius:50%;background:#86c9ff}.favLogo{max-width:65px;max-height:50px;object-fit:contain}.favFallback{font-size:12px;text-align:center;font-weight:700;line-height:1.12}.favoritesFooter{display:flex;justify-content:flex-end;padding:2px 18px 0}.primaryAction{border:0;border-radius:999px;background:#f5f6f7;color:#383a3d;font-size:13px;font-weight:780;letter-spacing:.02em;padding:11px 19px}.primaryAction:active{transform:scale(.985)}.browserView{display:none;background:#08090b;min-height:calc(100vh - 66px);padding:15px 14px 30px}.browserView.active{display:block}.miniNow{display:flex;align-items:center;gap:11px;border:1px solid #242930;background:#15181d;border-radius:17px;padding:10px 11px;margin-bottom:16px}.miniNowLogo{width:42px;height:42px;object-fit:contain;border-radius:10px;background:#fff;padding:5px}.miniNowText{min-width:0;flex:1}.miniNowName{font-size:14px;font-weight:740;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.miniNowMeta{font-size:10px;color:#90959d;margin-top:3px}.miniNowLive{font-size:10px;font-weight:800;letter-spacing:.08em;color:#ff7180}.browseHeader{display:flex;align-items:end;justify-content:space-between;gap:14px;margin:4px 3px 12px}.browseTitle{font-size:25px;font-weight:760;letter-spacing:-.035em}.count{font-size:12px;color:#777d86}.searchRow{display:flex;gap:9px;margin-bottom:10px}.searchRow input{width:100%;height:46px;border:1px solid #30353d;border-radius:15px;background:#191c21;color:#fff;padding:0 15px;font-size:15px;outline:none}.searchRow input:focus{border-color:#6bc8ff;box-shadow:0 0 0 3px rgba(107,200,255,.1)}.groupRail{display:flex;gap:8px;overflow-x:auto;padding:0 0 13px;scrollbar-width:none}.groupRail::-webkit-scrollbar{display:none}.groupChip{flex:0 0 auto;border:1px solid #30353c;background:#15181d;color:#c7cad0;border-radius:999px;padding:8px 12px;font-size:12px}.groupChip.active{background:#f1f2f3;color:#18191c;border-color:#f1f2f3;font-weight:720}.channelGrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.channel{min-width:0;border:1px solid #292e35;background:#171a1f;color:#fff;border-radius:16px;min-height:78px;padding:10px;display:flex;align-items:center;gap:9px;text-align:left}.channel.active{background:#343840;border-color:#515861}.channelLogo{width:48px;height:42px;object-fit:contain;flex:0 0 auto}.channelInfo{min-width:0}.channelName{font-size:12px;font-weight:740;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.channelGroup{font-size:9px;color:#8f949c;margin-top:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.loadMore{display:none;margin:16px auto 2px;border:1px solid #333841;background:#191c21;color:#d8dbe0;border-radius:999px;padding:10px 17px;font-size:12px}.loadMore.show{display:block}.emptyFav{padding:0 18px;color:#9ca1a8;font-size:13px}.bottomNav{position:fixed;left:0;right:0;bottom:0;z-index:60;background:#1a1d22;border-top:1px solid #24282f;padding:7px 6px max(7px,env(safe-area-inset-bottom));display:grid;grid-template-columns:repeat(5,1fr)}.navItem{border:0;background:transparent;color:#858b94;min-width:0;padding:1px 2px 0;font-size:10px;font-weight:650;display:flex;flex-direction:column;align-items:center;gap:3px}.navIcon{height:29px;min-width:38px;border-radius:19px;display:grid;place-items:center}.navIcon svg{width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.navItem.active{color:#fff}.navItem.active .navIcon{background:#666b74;padding:0 12px}.navItem[data-nav="favorites"] .navIcon svg{fill:currentColor;stroke:none}.homeView.hidden{display:none}@media(min-width:700px){body{padding-bottom:0}.shell{padding:0 16px}.appHeader{border-radius:0 0 18px 18px}.hero{border-radius:20px;margin-top:10px}.favoritesPanel{margin-top:14px;border-radius:22px}.bottomNav{left:50%;right:auto;transform:translateX(-50%);width:min(720px,94vw);border-radius:22px 22px 0 0}.channelGrid{grid-template-columns:repeat(4,minmax(0,1fr))}.favCard{flex-basis:96px;height:96px}}@media(orientation:landscape) and (max-height:620px){body{padding-bottom:0}.shell{max-width:none;padding:0}.appHeader,.homeView>.favoritesPanel,.browserView,.bottomNav{display:none!important}.homeView{display:block!important}.hero{position:fixed;inset:0;z-index:80;border-radius:0;margin:0}.hero live-video-player,.hero live-video-skin{width:100%;height:100vh}.hero live-video-skin{aspect-ratio:auto}.heroInfo{left:6vw;bottom:7vh}.heroLogo{right:5vw;bottom:7vh}.status{left:50%;right:auto;transform:translate(-50%,-4px);width:min(520px,80vw)}.status.show{transform:translate(-50%,0)}}
</style>
</head>
<body>
<div class="shell">
  <header class="appHeader">
    <div class="headerLeft"><div class="avatar" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4" fill="currentColor"/><path d="M4 21c1.2-4.3 4-6.5 8-6.5S18.8 16.7 20 21" fill="currentColor"/></svg></div><div id="pageTitle" class="pageTitle">Para Si</div></div>
    <div class="headerActions"><button id="fullscreenBtn" class="iconBtn" aria-label="Ecrã inteiro"><svg viewBox="0 0 24 24"><path d="M8 3H3v5M16 3h5v5M8 21H3v-5M16 21h5v-5"/></svg></button><button id="favoriteBtn" class="iconBtn" aria-label="Favorito"><svg viewBox="0 0 24 24"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8Z"/></svg></button></div>
  </header>
  <section id="homeView" class="homeView">
    <section class="hero loading" id="hero">
      <live-video-player id="livePlayer"><live-video-skin><video id="video" playsinline></video></live-video-skin></live-video-player>
      <div id="heroBackdrop" class="heroBackdrop"></div><div class="heroShade"></div>
      <div class="heroFallback"><div class="fallbackCard"><img id="fallbackLogo" class="fallbackLogo" alt="" hidden><div id="fallbackText" class="fallbackText">A preparar emissão…</div><button id="retryBtn" class="retryBtn">TENTAR NOVAMENTE</button></div></div>
      <div class="heroInfo"><div class="livePill"><span class="liveDot"></span>Em direto</div><div id="nowName" class="heroName">Escolhe um canal</div><div id="nowMeta" class="heroMeta">LiveTV</div></div>
      <img id="nowLogo" class="heroLogo" alt="" hidden><div id="status" class="status">A preparar emissão…</div>
    </section>
    <section class="favoritesPanel" id="favoritesSection"><div class="sectionHead"><div class="sectionTitle">Os Meus Canais</div><div id="favoriteCount" class="sectionMeta"></div></div><div id="favoritesRail" class="favoriteRail"></div><div class="favoritesFooter"><button id="allChannelsBtn" class="primaryAction">TODOS OS CANAIS</button></div></section>
  </section>
  <section id="browserView" class="browserView">
    <button id="miniNow" class="miniNow" type="button"><img id="miniNowLogo" class="miniNowLogo" alt="" hidden><div class="miniNowText"><div id="miniNowName" class="miniNowName">Nenhum canal selecionado</div><div id="miniNowMeta" class="miniNowMeta">Toca para voltar ao direto</div></div><div class="miniNowLive">DIRETO</div></button>
    <div class="browseHeader"><div id="browseTitle" class="browseTitle">Todos os canais</div><div id="summary" class="count">A carregar…</div></div>
    <div class="searchRow"><input id="search" placeholder="Pesquisar canal" autocomplete="off" inputmode="search"></div>
    <div id="groupRail" class="groupRail" aria-label="Grupos de canais"></div><div id="list" class="channelGrid"></div><button id="loadMoreBtn" class="loadMore">MOSTRAR MAIS</button>
  </section>
</div>
<nav class="bottomNav" aria-label="Navegação">
  <button class="navItem active" data-nav="home"><span class="navIcon"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M8 19v2m8-2v2"/></svg></span><span>Para Si</span></button>
  <button class="navItem" data-nav="zap"><span class="navIcon"><svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h10"/></svg></span><span>Zapping</span></button>
  <button class="navItem" data-nav="channels"><span class="navIcon"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m10 8 6 4-6 4Z"/></svg></span><span>Explorar</span></button>
  <button class="navItem" data-nav="favorites"><span class="navIcon"><svg viewBox="0 0 24 24"><path d="M12 21S3 15.6 3 9.5A4.5 4.5 0 0 1 11 6.7L12 8l1-1.3A4.5 4.5 0 0 1 21 9.5C21 15.6 12 21 12 21Z"/></svg></span><span>Favoritos</span></button>
  <button class="navItem" data-nav="search"><span class="navIcon"><svg viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg></span><span>Pesquisa</span></button>
</nav>
<script src="app.js"></script>
</body>
</html>
